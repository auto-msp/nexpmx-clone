// Prisma schema — clean-room domain model for a Business-Memory SaaS.
// Reconstructed from observable product behavior; see docs/DATABASE.md
// for the OBSERVED / INFERRED / ASSUMED provenance of every entity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  image         String?
  googleId      String?        @unique
  role          Role           @default(MEMBER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]
  decisions     Decision[]
  comments      Comment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  documents     Document[]

  @@index([email])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  CLIENT
  GUEST
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  brandColor     String   @default("#2563eb")
  logoUrl        String?
  plan           Plan     @default(STARTER)
  aiCreditsLimit Int      @default(1000)
  aiCreditsUsed  Int      @default(0)
  storageLimitMb Int      @default(10240)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Company profile (Setup → Company & GST). Optional until the operator
  // completes it; invoice composer surfaces it for GST-aligned line items.
  gstin        String?
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?
  country      String   @default("India")
  // Payments: UPI VPA for invoice payment links (rendered as upi:// intent).
  upiId        String?
  upiPayeeName String?

  // Notification preferences (Setup → Notifications). All default-on for
  // trial orgs; toggles are org-wide and audited when changed.
  notifyPayments   Boolean @default(true)
  notifyProposals  Boolean @default(true)
  notifyMilestones Boolean @default(true)
  notifyWeeklyDigest Boolean @default(true)

  memberships     Membership[]
  clients         Client[]
  projects        Project[]
  invoices        Invoice[]
  decisions       Decision[]
  documents       Document[]
  automations     Automation[]
  proposals       Proposal[]
  commsMessages   CommsMessage[]
  memoryFacts     MemoryFact[]
  memoryQuestions MemoryQuestion[]
  sheets          Sheet[]
  aiEmployees     AiEmployee[]
  auditLogs       AuditLog[]
  usageEvents     UsageEvent[]
  apiKeys         ApiKey[]
  invitations     Invitation[]
  subscription    Subscription?
  idempotencyKeys IdempotencyKey[]
  checkoutSessions CheckoutSession[]
  billingEvents   BillingEvent[]
}

enum Plan {
  STARTER
  GROWTH
  SCALE
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      Role         @default(MEMBER)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

// ─── Core business memory ────────────────────────────────────────────────────

model Client {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  company     String?
  email       String?
  phone       String?
  status      ClientStatus @default(ACTIVE)
  portalToken String       @unique @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  projects  Project[]
  invoices  Invoice[]
  documents Document[]
  decisions Decision[]
  comments  Comment[]
  proposals Proposal[]
  commsMessages CommsMessage[]

  @@index([orgId, status])
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id        String        @id @default(cuid())
  orgId     String
  clientId  String?
  name      String
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tasks     Task[]
  documents Document[]
  decisions Decision[]
  comments  Comment[]

  @@index([orgId, status])
  @@index([clientId])
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

model Task {
  id         String     @id @default(cuid())
  orgId      String
  projectId  String
  title      String
  status     TaskStatus @default(TODO)
  assigneeId String?
  dueDate    DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([orgId, projectId, status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Invoice {
  id          String        @id @default(cuid())
  orgId       String
  clientId    String
  number      String
  amountMinor Int // minor units (paise) — never store money as float; NET of tax
  currency    String        @default("INR")
  status      InvoiceStatus @default(DRAFT)
  // GST fields (India): rate in basis points of NET (0/500/1200/1800/2800),
  // place of supply state name, and the seller GSTIN snapshot at issue time.
  gstRateBps  Int           @default(0)
  placeOfSupply String?
  gstinSnapshot String?
  issuedAt    DateTime?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([orgId, number])
  @@index([orgId, status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Decision {
  id        String       @id @default(cuid())
  orgId     String
  authorId  String
  projectId String?
  clientId  String?
  title     String
  body      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  comments  Comment[]

  @@index([orgId, createdAt])
}

model Document {
  id           String       @id @default(cuid())
  orgId        String
  uploaderId   String
  projectId    String?
  clientId     String?
  title        String
  mimeType     String
  sizeBytes    Int
  storageKey   String       @unique // object-storage key; never the raw URL
  originalName String // client-supplied filename; stored but never used to build paths
  sha256       String // integrity + future dedup (NOT the encryption key)
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, clientId])
  @@index([uploaderId])
}

model Comment {
  id         String    @id @default(cuid())
  orgId      String
  authorId   String
  body       String
  decisionId String?
  projectId  String?
  clientId   String?
  createdAt  DateTime  @default(now())
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  decision   Decision? @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId, decisionId])
  @@index([orgId, projectId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  orgId       String
  type        String
  payloadJson String    @default("{}")
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metaJson  String       @default("{}")
  ip        String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([entity, entityId])
}

model UsageEvent {
  id        String       @id @default(cuid())
  orgId     String
  kind      String // e.g. "ai.search", "ai.generate"
  credits   Int          @default(0)
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, kind, createdAt])
}

model ApiKey {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  prefix    String
  keyHash   String       @unique // SHA-256 of the raw key; raw key is never stored
  revokedAt DateTime?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Automation {
  id         String       @id @default(cuid())
  orgId      String
  name       String
  enabled    Boolean  @default(false)
  trigger    String // typed keys: invoice.paid, proposal.signed, project.created, task.completed, milestone.completed (see src/lib/automations.ts)
  notifyFounders Boolean @default(false)
  notifyClient   Boolean @default(false)
  createTask     Boolean @default(false)
  taskTitle      String?
  watchScope     String  @default("ALL") // ALL | CLIENT | PROJECT
  watchClientId  String?
  watchProjectId String?
  lastFiredAt    DateTime?
  configJson String       @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ─── Proposals (sales pipeline) ─────────────────────────────────────────────
// Screenshot evidence: pipeline board with Draft/Sent/Viewed/Accepted/Rejected
// columns, value totals per stage, and a signed→invoice hand-off (the
// "Raise the first invoice when a proposal is signed" automation).

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

model Proposal {
  id          String         @id @default(cuid())
  orgId       String
  clientId    String?
  title       String
  amountMinor Int            @default(0) // minor units (paise), mirrors Invoice
  currency    String         @default("INR")
  status      ProposalStatus @default(DRAFT)
  notes       String?
  sentAt      DateTime?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  org         Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([clientId])
}

// ─── Comms (client communication log) ───────────────────────────────────────
// Screenshot evidence: unified thread per client (email/MEETING/CALL/NOTE),
// composer + "log an interaction" entry, filter by direction.

model CommsMessage {
  id        String   @id @default(cuid())
  orgId     String
  clientId  String?
  direction String   @default("OUT") // OUT | IN
  channel   String   @default("EMAIL") // EMAIL | CALL | MEETING | NOTE
  subject   String
  body      String?
  authorId  String?
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([orgId, sentAt])
  @@index([orgId, clientId])
}

// ─── Business Memory (facts, questions, import) ────────────────────────────
// Screenshot evidence: Business Memory list with category chips + add form;
// "What we know" rolling summary; "Memory questions" suggestion log with
// answered state; a paste-import flow (``key: value'' lines).

enum MemoryFactStatus {
  ACTIVE
  ARCHIVED
}

model MemoryFact {
  id        String           @id @default(cuid())
  orgId     String
  category  String           @default("general")
  factKey   String
  value     String
  status    MemoryFactStatus @default(ACTIVE)
  authorId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, factKey])
  @@index([orgId, category, status])
}

enum MemoryQuestionState {
  OPEN
  ANSWERED
}

model MemoryQuestion {
  id        String              @id @default(cuid())
  orgId     String
  question  String
  answer    String?
  state     MemoryQuestionState @default(OPEN)
  askerId   String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, state, createdAt])
}

// ─── Sheets (spreadsheets) ──────────────────────────────────────────────────
// Screenshot evidence: workbook list with empty-state, grid editor with
// toolbar (bold/align/₹/%, filter, freeze), formula bar with fx, Export,
// Share. Cells stored sparsely as JSON keyed "A1"-style.

model Sheet {
  id        String   @id @default(cuid())
  orgId     String
  title     String
  cellsJson String   @default("{}")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, updatedAt])
}

// ─── AI team (virtual employees) ────────────────────────────────────────────
// Screenshot evidence: AI Team page with role cards (Aria the Project
// Manager, Vikram Finance, Maya Operations, Leo Client Success, Sage Sales),
// each with an optional AI Credits price and "What I own" task list; Skills
// cards show "Taught to <names>".

model AiEmployee {
  id        String   @id @default(cuid())
  orgId     String
  key       String // aria | vikram | maya | leo | sage
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId, enabled])
}

// ─── Idempotency ─────────────────────────────────────────────────────────────
// Server-side idempotency for create operations (resilience follow-up):
// the form supplies a random key; the first insert records it inside the
// same transaction. A retried submission with the same key returns the
// original result instead of creating a second row.

model IdempotencyKey {
  id        String       @id @default(cuid())
  orgId     String
  scope     String // e.g. "client.create", "invoice.create"
  key       String
  entityId  String // id of the record created under this key
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, scope, key])
  @@index([orgId, createdAt])
}

// ─── Billing lifecycle ───────────────────────────────────────────────────────
// TRIALING state is evidence-backed (account-holder report of a 14-day trial
// at signup, docs/ASSUMPTIONS.md §8). Payment rail: Razorpay orders + webhook
// activation (ADR-017). State transitions are explicit and tested —
// src/lib/subscription-state.ts is the authoritative table.

enum SubscriptionState {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                    String            @id @default(cuid())
  orgId                 String            @unique
  state                 SubscriptionState @default(TRIALING)
  plan                  Plan
  trialEndsAt           DateTime? // set at TRIALING creation; null for non-trial states
  currentPeriodStart    DateTime? // set at activation/renewal (webhook time)
  currentPeriodEnd      DateTime? // set at activation/renewal (+30d)
  seats                 Int? // seats paid for at activation (seat-based pricing)
  razorpaySubscriptionId String? // provider subscription id, when one exists
  lastPaymentAt         DateTime? // last captured payment we processed
  lastPaymentId         String? // provider payment id (payment_xxx)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  org                   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  checkoutSessions CheckoutSession[]

  @@index([orgId, state])
}

// One checkout attempt = one Razorpay order. Sessions are org-scoped and
// carry a server-computed quote (plan + seats × price) — the browser never
// states an amount. Only the webhook (verified signature) completes one.
enum CheckoutState {
  CREATED
  COMPLETED
  EXPIRED
}

model CheckoutSession {
  id              String        @id @default(cuid())
  orgId           String
  subscriptionId  String? // owning lifecycle row; nullable for defensive direct org linkage
  plan            Plan
  seats           Int
  amountMinor     Int // server-computed quote: seats × plan price (paise)
  currency        String        @default("INR")
  state           CheckoutState @default(CREATED)
  razorpayOrderId String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  completedAt     DateTime?
  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([orgId, state])
}

// Raw webhook ledger + idempotency: (provider, eventType, externalId) unique
// so Razorpay's at-least-once redelivery is processed exactly once. Events
// that cannot be mapped to an org are still stored (orgId null) for ops.
model BillingEvent {
  id          String    @id @default(cuid())
  orgId       String?
  provider    String    @default("razorpay")
  eventType   String // e.g. payment.captured, subscription.charged
  externalId  String // provider entity id (pay_xxx / sub_xxx)
  payloadJson String // full event body (contains no secrets; redacted keys)
  processedAt DateTime?
  receivedAt  DateTime  @default(now())
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([provider, eventType, externalId])
  @@index([orgId, receivedAt])
}

// ─── Team invitations ────────────────────────────────────────────────────────
// Single-use capability tokens, hashed at rest like API keys (raw token
// survives only in the invite link, which is emailed out-of-band).

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id         String           @id @default(cuid())
  orgId      String
  email      String
  role       Role             @default(MEMBER)
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDING)
  invitedBy  String
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?
  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([email])
}

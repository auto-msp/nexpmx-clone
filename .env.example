# ── BizMemory environment ─────────────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

# PostgreSQL (local dev / staging / production differ — see docs/DEPLOYMENT.md)
DATABASE_URL="postgresql://bizmemory:bizmemory@localhost:5432/bizmemory"

# Auth.js v5 secret (generate: `openssl rand -base64 32`)
AUTH_SECRET=""

# Google OAuth credentials (console.cloud.google.com → OAuth client)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails auto-promoted to OWNER on first login
OWNER_EMAILS=""

# AI assistant adapter (provider-agnostic; see docs/BACKEND.md)
# "stub" answers from indexed local context only — no external calls
AI_PROVIDER="stub"

# Public site URL (used for OAuth callback origin)
AUTH_URL="http://localhost:3000"

# Document Hub storage (KNOWN_LIMITATIONS #1)
# Directory where uploaded files are stored. Must exist and be writable by
# the app user. In production the systemd unit grants ReadWritePaths on it.
DOCUMENT_STORAGE_DIR="/var/lib/bizmemory/documents"
# Optional dedicated secret for signed download links (falls back to AUTH_SECRET)
DOCUMENT_TOKEN_SECRET=""

# Billing — Razorpay (ADR-017; KNOWN_LIMITATIONS #2/#16)
# Key id is public (rendered into the checkout page); key secret and webhook
# secret are server-only. All three are required for self-serve checkout to
# activate; without them the app runs with checkout disabled (contact-us mode).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email delivery (KNOWN_LIMITATIONS #9) — Resend REST API, no SDK needed.
# Without a key the app logs email intent and still shows one-time invite
# links (invite flow never blocks on mail).
RESEND_API_KEY=""
MAIL_FROM_NAME="BizMemory"
MAIL_FROM_ADDRESS="onboarding@resend.dev"   # set to invites@yourdomain after domain verification
